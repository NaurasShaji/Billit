+
+    final sales = await Hive.openBox<Sale>('sales');
+    await sales.put(
+      'INV-0001',
+      Sale()
+        ..id = 'INV-0001'
+        ..date = DateTime(2025, 3, 14, 10, 30, 15, 250)
+        ..items = [
+          SaleItem()
