+import 'package:sqlite3/common.dart';
+
+const int schemaVersion = 1;
+
+/// Key/value tables. Values are stored as JSON text.
+const List<String> keyValueTables = [
+  'app_settings',
+  'session',
+  'device_settings',
+  'meta',
+];
+
+final List<String> _schemaV1 = [
+  '''
+  CREATE TABLE users (
+    id TEXT NOT NULL PRIMARY KEY,
+    username TEXT NOT NULL,
+    password TEXT NOT NULL,
+    user_type TEXT NOT NULL,
+    security_answer TEXT NOT NULL,
+    security_question TEXT NOT NULL
+  )''',
+  '''
+  CREATE TABLE products (
+    id TEXT NOT NULL PRIMARY KEY,
+    name TEXT NOT NULL,
+    selling_price REAL,
+    cost_price REAL,
+    stock REAL,
+    unit TEXT NOT NULL,
+    category TEXT NOT NULL,
+    sub_category TEXT NOT NULL,
+    active INTEGER NOT NULL,
+    barcode TEXT,
+    hsn_code TEXT NOT NULL,
+    gst_rate REAL
+  )''',
+  'CREATE INDEX products_barcode ON products (barcode)',
+  '''
+  CREATE TABLE sales (
+    id TEXT NOT NULL PRIMARY KEY,
+    date INTEGER NOT NULL,
+    total_amount REAL,
+    total_cost REAL,
+    profit REAL,
+    payment TEXT NOT NULL,
+    customer_name TEXT NOT NULL,
+    customer_phone TEXT NOT NULL,
+    user_id TEXT NOT NULL,
+    discount REAL,
+    gst_enabled INTEGER NOT NULL,
+    gst_rate REAL,
+    taxable_amount REAL,
+    cgst_amount REAL,
+    sgst_amount REAL,
+    igst_amount REAL,
+    customer_gstin TEXT NOT NULL,
+    interstate_sale INTEGER NOT NULL,
+    gst_inclusive INTEGER NOT NULL
+  )''',
+  'CREATE INDEX sales_date ON sales (date)',
+  '''
+  CREATE TABLE sale_items (
+    sale_id TEXT NOT NULL REFERENCES sales (id) ON DELETE CASCADE,
+    position INTEGER NOT NULL,
+    product_id TEXT NOT NULL,
+    qty REAL,
+    selling_price REAL,
+    cost_price REAL,
+    subtotal REAL,
+    unit_label TEXT NOT NULL,
+    hsn_code TEXT NOT NULL,
+    gst_rate REAL,
+    taxable_amount REAL,
+    cgst_amount REAL,
+    sgst_amount REAL,
+    igst_amount REAL,
+    PRIMARY KEY (sale_id, position)
