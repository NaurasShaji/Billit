+    dir = Directory.systemTemp.createTempSync('billit_db_test');
+    path = '${dir.path}/billit.db';
+    openDatabaseFile(path);
+  });
+
+  tearDown(() {
+    Db.close();
+    dir.deleteSync(recursive: true);
+  });
+
+  void reopen() {
+    Db.close();
+    openDatabaseFile(path);
+  }
+
+  test('every record type survives closing and reopening the database',
+      () async {
+    final user = User()
+      ..id = 'u1'
+      ..username = 'owner'
